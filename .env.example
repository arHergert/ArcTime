# Kopiere diese Datei nach D:\Dokumente\Programmierung\arctime.env (oder an
# einen beliebigen anderen Ort - dann ARCTIME_ENV_FILE als Umgebungsvariable
# darauf zeigen lassen) und trage echte Werte ein. Die echte Datei mit echten
# Keys gehört NICHT in dieses Repo.

# -- API-Zugangsdaten --
# OMDB: kostenloser Key unter https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# TMDB: kostenloser Key unter https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# IGDB (via Twitch-OAuth): https://api-docs.igdb.com/#getting-started
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# -- Pfade --
# Ordner, der die Unterordner "Filme" und "Serien" enthält.
ARCTIME_MEDIA_DIR=D:\Downloads\jMedien

# Optional: eigener Cache-Ort. Wenn leer/auskommentiert, wird automatisch der
# Ordner "cache" eine Ebene über diesem src-Ordner verwendet.
#ARCTIME_CACHE_DIR=G:\Programme\ArcTime\cache
